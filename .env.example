# --- DigitalOcean Gradient / serverless inference (OpenAI-compatible) — primary engine ---
OPENAI_BASE_URL=https://inference.do-ai.run/v1
OPENAI_API_KEY=do-inference-...
# light/bulk model (triage, consolidate, QA, improve, briefing)
OPENAI_MODEL=openai-gpt-oss-20b
# heavier model for REM cross-thread synthesis (falls back to OPENAI_MODEL if unset)
OPENAI_REM_MODEL=openai-gpt-oss-120b

# --- optional: Anthropic engine ---
ANTHROPIC_API_KEY=sk-ant-...
NOCTURNE_MODEL=claude-sonnet-4-6

NOCTURNE_TOKEN_BUDGET=1200
NOCTURNE_CASSETTE_DIR=runs/cassettes
